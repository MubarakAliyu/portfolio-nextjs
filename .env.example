# Copy to .env.local (and add the same keys in Vercel → Project → Settings → Environment Variables)
# to have the contact form send real emails through Resend (https://resend.com).
# Without them the form still works: messages are logged on the server instead.

# Your Resend API key
RESEND_API_KEY=

# Where contact form messages should be delivered
CONTACT_TO=aliyumubarak.ui@gmail.com

# Optional: the sender, from a domain you've verified in Resend
CONTACT_FROM=Portfolio <onboarding@resend.dev>
