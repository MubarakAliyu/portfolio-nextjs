# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude md
CLAUDE.md
AGENTS.md

# Project specific
DESIGN.md
PROJECT-MEDIA-GUIDE.md

# Project media: commit only what the site reads (cover.*, gallery/ images,
# screens/desktop.* and screens/mobile.*). Raw brand packs, PDFs, zips, fonts
# and extra sub-folders dropped into a project folder stay on this computer.
/public/images/projects/*/*
!/public/images/projects/*/cover.*
!/public/images/projects/*/gallery/
!/public/images/projects/*/screens/
/public/images/projects/*/gallery/*
/public/images/projects/*/screens/*
!/public/images/projects/*/gallery/*.jpg
!/public/images/projects/*/gallery/*.jpeg
!/public/images/projects/*/gallery/*.png
!/public/images/projects/*/gallery/*.webp
!/public/images/projects/*/gallery/*.avif
!/public/images/projects/*/screens/desktop.*
!/public/images/projects/*/screens/mobile.*
!/public/images/projects/*/*/.gitkeep
